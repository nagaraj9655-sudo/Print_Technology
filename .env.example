# Copy this file to ".env" and fill in your Supabase project values.
# Find them in Supabase → Project Settings → API.
#
# Leave these blank/absent to keep running on local browser storage (no backend).
# Set both to switch the app into Supabase mode (real login + cloud database).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
